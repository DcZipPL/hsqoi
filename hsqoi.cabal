cabal-version:      3.0
name:               hsqoi
version:            0.1.0.0
description:        Please see the README on GitHub at <https://github.com/0xd34df00d/hsqoi#readme>
homepage:           https://github.com/0xd34df00d/hsqoi#readme
bug-reports:        https://github.com/0xd34df00d/hsqoi/issues
author:             Georg Rudoy
maintainer:         0xd34df00d@gmail.com
copyright:          2021 Georg Rudoy
license:            BSD-3-Clause
license-file:       LICENSE
build-type:         Simple
extra-doc-files:
    README.md
    ChangeLog.md

source-repository head
  type:     git
  location: https://github.com/0xd34df00d/hsqoi

flag llvm
  description: Compile with the LLVM backend (GHC 9.6 needs LLVM 11–15).
  default:     True
  manual:      True

common shared
  default-language: Haskell2010
  ghc-options:      -Wall
  if flag(llvm)
    ghc-options:    -fllvm
  build-depends:
      base >=4.15 && <5
    , array
    , binary
    , binary-generic-combinators >=0.4.4.0
    , bytestring

library
  import:           shared
  hs-source-dirs:   src
  exposed-modules:
      Data.Image.Qoi.Decoder
      Data.Image.Qoi.Encoder
      Data.Image.Qoi.Format
      Data.Image.Qoi.Pixel
      Data.Image.Qoi.Util

executable hsqoi-exe
  import:           shared
  hs-source-dirs:   app
  main-is:          Main.hs
  ghc-options:      -rtsopts
  build-depends:
      hsqoi
    , JuicyPixels
    , mmap

test-suite hsqoi-test
  import:           shared
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N
  build-depends:
      hsqoi
    , hspec
    , QuickCheck
    , vector
